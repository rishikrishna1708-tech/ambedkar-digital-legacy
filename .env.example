# DAIC Archive Configuration
# DATA_MODE can be 'demo' or 'real'
DATA_MODE=demo

# Google Gemini API Key (optional for DEMO MODE, required for live generation)
GEMINI_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# RRF Configuration
RRF_K=60

# Evidence Gate Thresholds
MIN_EVIDENCE_SCORE=0.35
MIN_SUPPORTING_SOURCES=1
